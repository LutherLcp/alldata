{
  "name": "@alldata/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./types": {
      "import": "./dist/src/types/index.js",
      "types": "./dist/src/types/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/src/schemas/index.js",
      "types": "./dist/src/schemas/index.d.ts"
    },
    "./utils": {
      "import": "./dist/src/utils/index.js",
      "types": "./dist/src/utils/index.d.ts"
    },
    "./constants": {
      "import": "./dist/src/constants/index.js",
      "types": "./dist/src/constants/index.d.ts"
    },
    "./validators": {
      "import": "./dist/src/validators/index.js",
      "types": "./dist/src/validators/index.d.ts"
    },
    "./tests/factories": {
      "import": "./dist/tests/factories/index.js",
      "types": "./dist/tests/factories/index.d.ts"
    }
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.0",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
