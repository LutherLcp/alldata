# AllData 全域数据运营平台 — 环境变量模板
#
# 用法：cp .env.example .env 后按需修改。
# 生产环境请使用密码管理器 / Docker secrets / Vault 注入，切勿提交真实密钥。

# ─── Node 运行环境 ─────────────────────────────────────────
NODE_ENV=development

# ─── API 服务 ──────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# ─── PostgreSQL（业务元数据）───────────────────────────────
POSTGRES_DB=alldata
POSTGRES_USER=alldata
# 必填：请替换为强密码
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://alldata:change-me-postgres-password@localhost:5432/alldata?schema=public

# ─── Redis（缓存 / 队列）───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT 认证（必填，生产请使用 32 位以上随机串）───────────
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change-me-refresh-secret-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters

# ─── CORS 白名单（逗号分隔，支持多个 Origin）───────────────
CORS_ORIGINS=http://localhost:3000

# ─── MinIO（对象存储）──────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=alldata
# 供 api 容器使用
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
# 供 minio 容器初始化使用
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# ─── ClickHouse（OLAP 分析库）──────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=alldata
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Kafka（事件管道，可选）────────────────────────────────
KAFKA_BROKERS=
KAFKA_TOPIC_EVENTS=

# ─── AI / LLM（可选，留空则走 mock 降级）───────────────────
LLM_PROVIDER=OPENAI
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30000

# ─── 前端 ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000
