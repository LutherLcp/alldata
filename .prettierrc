{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-packagejson", "prettier-plugin-organize-imports"],
  "overrides": [
    {
      "files": "*.{json,jsonc,yaml,yml,md,mdx}",
      "options": {
        "printWidth": 120
      }
    },
    {
      "files": "*.{html,vue,svelte}",
      "options": {
        "parser": "html"
      }
    }
  ]
}